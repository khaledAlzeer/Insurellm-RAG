# Copy to .env to override defaults. Every value below is optional; no secrets are needed.
# INSURELLM_OLLAMA_BASE_URL=http://localhost:11434
# INSURELLM_CHAT_MODEL=llama3.2
# INSURELLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# INSURELLM_EMBEDDING_DEVICE=auto          # auto | cpu | cuda
# INSURELLM_RERANK_ENABLED=true
# INSURELLM_CHUNK_SIZE=900
# INSURELLM_CHUNK_OVERLAP=120
# INSURELLM_LOG_LEVEL=INFO
# INSURELLM_UI_PORT=7860
